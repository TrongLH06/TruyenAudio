# API backend URL when deploying frontend separately (e.g. GitHub Pages -> Hugging Face Spaces)
# Leave empty during local dev to use Vite's /api and /storage proxy.
# Example: VITE_API_BASE_URL=https://ten-user-luoi-truyen-api.hf.space
VITE_API_BASE_URL=

# Asset base path (use "./" for GitHub Pages subpath hosting, "/" for root hosting)
VITE_BASE_PATH=/

# Set to "true" on static hosts without SPA rewrites (e.g. GitHub Pages) to avoid 404 on reload
VITE_USE_HASH_ROUTER=false
