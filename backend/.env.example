# Server & Security
APP_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret-string-min-32-chars
API_KEY_ENCRYPTION_KEY=change-this-to-another-long-random-encryption-key-min-32-chars
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for preview origins (e.g. https://.*\.github\.io)
CORS_ORIGIN_REGEX=

# Database (SQLite local; swap to postgresql+psycopg://... for production)
DATABASE_URL=sqlite:///./storage/app.db

# Gemini API (Google AI Studio free tier or paid key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Daily free server-key narration quota per user (bypassed when user supplies BYOK key)
DAILY_FREE_NARRATION_LIMIT=30

# Storage & OCR model directories (relative to backend/ or absolute path)
STORAGE_DIR=./storage
OCR_MODELS_DIR=

# Optional initial owner/admin account (auto-created on startup if set)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
